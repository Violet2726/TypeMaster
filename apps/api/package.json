{
  "name": "@typemaster/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@clerk/backend": "^3.5.0",
    "@hono/node-server": "^1.14.4",
    "@typemaster/ai": "workspace:*",
    "@typemaster/contracts": "workspace:*",
    "@typemaster/domain": "workspace:*",
    "@upstash/redis": "^1.38.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.9.7",
    "inngest": "^4.5.0",
    "postgres": "^3.4.9",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@typemaster/config": "workspace:*",
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^2.1.9",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "node -e \"require('fs').mkdirSync('dist', { recursive: true }); console.log('Prepared @typemaster/api build workspace')\"",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "test": "vitest run --config vitest.config.js",
    "test:coverage": "vitest run --config vitest.config.js --coverage",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.json"
  }
}
