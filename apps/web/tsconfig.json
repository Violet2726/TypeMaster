{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "react",
      "react-dom",
      "vitest/globals"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true,
    "jsx": "preserve",
    "strictNullChecks": false
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
