    "react-dom": "^18.2.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.9",
    "c8": "^11.0.0",
    "jsdom": "^29.1.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=18.x"
  }
}
