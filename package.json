{
  "name": "typemaster",
  "version": "2.0.0",
  "description": "TypeMaster 2.0 AI coach typing trainer",
  "main": "server.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
