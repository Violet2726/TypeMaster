{
    "name": "typerift-workspace",
    "private": true,
    "packageManager": "pnpm@10.20.0",
    "scripts": {
        "dev": "turbo run dev --parallel",
        "dev:web": "pnpm --filter @typerift/web dev",
        "dev:api": "pnpm --filter @typerift/api dev",
        "build": "turbo run build",
        "test": "turbo run test",
        "typecheck": "pnpm --filter @typerift/domain typecheck && pnpm --filter @typerift/contracts typecheck && pnpm --filter @typerift/ui typecheck && pnpm --filter @typerift/ai typecheck && pnpm --filter @typerift/web typecheck && pnpm --filter @typerift/api typecheck",
        "test:coverage": "turbo run test:coverage",
        "test:e2e": "pnpm --filter @typerift/web test:e2e",
        "test:e2e:perf": "pnpm --filter @typerift/web test:e2e:perf",
        "test:e2e:all": "pnpm --filter @typerift/web test:e2e:all",
        "format:check": "prettier --check \"{apps,packages,scripts,docs}/**/*.{ts,tsx,js,mjs,json,css,md}\" \"*.json\" \"README*.md\"",
        "format": "prettier --write \"{apps,packages,scripts,docs}/**/*.{ts,tsx,js,mjs,json,css,md}\" \"*.json\" \"README*.md\"",
        "lint": "eslint apps packages --max-warnings=0",
        "audit:tokens": "node scripts/design-tokens-audit.js",
        "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm audit:tokens && pnpm build"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@next/eslint-plugin-next": "15.5.6",
        "eslint": "^9.32.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^16.3.0",
        "playwright": "^1.61.0",
        "prettier": "^3.6.2",
        "turbo": "^2.5.8",
        "typescript-eslint": "^8.38.0"
    },
    "engines": {
        "node": ">=20.9.0"
    }
}
