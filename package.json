{
  "name": "typemaster-workspace",
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @typemaster/web dev",
    "dev:api": "pnpm --filter @typemaster/api dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "pnpm --filter @typemaster/web typecheck && pnpm --filter @typemaster/api typecheck",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter @typemaster/web test:e2e"
  },
  "devDependencies": {
    "turbo": "^2.5.8"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
